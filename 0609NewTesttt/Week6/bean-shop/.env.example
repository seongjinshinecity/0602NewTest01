# ============================================================
# 서버 전용 비밀값 — .env 는 .gitignore 처리됨 (이 .env.example 만 커밋)
# 실제 값으로 채운 뒤 복사: cp .env.example .env
# ============================================================

# 토스페이먼츠 시크릿 키 (테스트 상점 키 예시)
TOSS_SECRET_KEY=test_gsk_docs_OaPz8L5KdmQXkzRz3y47BMw6

# 서버 자체 인증용 Postgres 접속 문자열 (Supabase → Project Settings → Database → Connection string)
# 예: postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.<ref>:<password>@<host>:6543/postgres
# 세션 JWT 서명 키 (긴 랜덤 문자열로 교체)
SESSION_SECRET=change-this-to-a-long-random-string

# ImageKit (대시보드 → Developer options). private 키는 절대 클라이언트에 두지 말 것.
IMAGEKIT_PUBLIC_KEY=public_xxxxxxxxxxxxxxxxxxxxxxxx
IMAGEKIT_PRIVATE_KEY=private_xxxxxxxxxxxxxxxxxxxxxxxx
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id

# 서버 포트 (successUrl origin과 동일해야 함)
PORT=3000
