# ──────────────────────────────────────────────────────────────
#  Copy this file to `.env.local` and fill in real values.
#  NEVER commit `.env.local` — it is gitignored.
# ──────────────────────────────────────────────────────────────

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# fal.ai — https://fal.ai/dashboard/keys   (format: key_id:key_secret)
# Server-only. Do NOT prefix with NEXT_PUBLIC_ or it leaks to the browser.
FAL_KEY=your_fal_key_id:your_fal_key_secret

# Optional: which fal model to use (default: fal-ai/flux/dev)
#   fal-ai/flux/dev      — high quality, ~10-25s
#   fal-ai/flux/schnell  — fastest, ~2-5s, lower fidelity
FAL_MODEL=fal-ai/flux/dev

# Optional: public base URL (used for auth email redirects in production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
