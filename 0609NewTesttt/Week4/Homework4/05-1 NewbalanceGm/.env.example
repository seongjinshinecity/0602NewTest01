# ── 데이터베이스 (선택) ──────────────────────────────────────
# Supabase 대시보드 → Project Settings → Database → Connection string(URI) 복사.
# 없으면 자동으로 임베디드 PostgreSQL(PGlite, ./data)을 사용합니다.
#
# DATABASE_URL=postgresql://postgres.xxxx:YOUR-PASSWORD@aws-1-us-east-1.pooler.supabase.com:6543/postgres

