# Supabase / PostgreSQL 연결 문자열 (한 줄)
# Supabase 대시보드 → Project Settings → Database → Connection string → "Connection pooling"(포트 6543) 권장
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-REGION.pooler.supabase.com:6543/postgres

# 세션 쿠키 서명 비밀키 (배포 시 임의의 긴 문자열로 교체)
SESSION_SECRET=change-me-to-a-long-random-string
